<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.THUNDERFOREST_API_KEY %>";
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
  console.log("MAP COORDINATES:", coordinates);
</script>

<div class="container-fluid px-lg-5 py-4">
  <div class="row justify-content-center">
    <!-- Main Content Column -->
    <div class="col-lg-8">
      <!-- Listing Header -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
          <h2 class="fw-bold text-red mb-2"><%= listing.title %></h2>
          <div class="d-flex align-items-center text-muted">
            <i class="bi bi-person-circle me-2"></i>
            <span>Hosted by @<%= listing.owner.username %></span>
          </div>
        </div>
        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
          <div class="d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
              <button class="btn btn-outline-danger btn-sm">Delete</button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- Listing Image -->
      <div class="rounded-3 overflow-hidden mb-4 shadow-sm">
        <img 
          src="<%= listing.image ? listing.image.url : '/images/default-listing.jpg' %>" 
          alt="<%= listing.title %>" 
          class="img-fluid w-100"
          style="height: 450px; object-fit: cover;"
        >
      </div>

      <!-- Key Details -->
      <div class="d-flex flex-wrap gap-4 mb-4">
        <div class="d-flex align-items-center bg-light rounded-pill px-3 py-2">
          <i class="bi bi-tag-fill text-primary me-2"></i>
          <span class="fw-medium"><%= listing.category %></span>
        </div>
        <div class="d-flex align-items-center bg-light rounded-pill px-3 py-2">
          <i class="bi bi-geo-alt-fill text-primary me-2"></i>
          <span class="fw-medium"><%= listing.location %>, <%= listing.country %></span>
        </div>
        <div class="d-flex align-items-center bg-light rounded-pill px-3 py-2">
          <i class="bi bi-cash-coin text-primary me-2"></i>
          <span class="fw-medium">₹<%= listing.price ? listing.price.toLocaleString('en-IN') : '' %>/night</span>
        </div>
      </div>

      <!-- Description -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title fw-semibold mb-3">About this place</h5>
          <p class="card-text"><%= listing.description %></p>
        </div>
      </div>

      <!-- Map Section -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0">
          <h5 class="fw-semibold mb-0">Location</h5>
        </div>
        <div class="card-body p-0">
          <div id="map" style="height: 350px; width: 100%; border-radius: 0 0 8px 8px;"></div>
        </div>
      </div>

      <!-- Reviews Section -->
      <div class="mb-4">
        <% if (currUser) { %>
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
              <h5 class="fw-semibold mb-3">Share your experience</h5>
              <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                <div class="mb-3">
                  <label class="form-label fw-medium">Your rating</label>
                  <div class="star-rating">
                    <div class="d-flex align-items-center gap-2">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <div class="form-check form-check-inline m-0">
                          <input class="form-check-input d-none" type="radio" name="review[rating]" id="rating-<%= i %>" value="<%= i %>" <%= i === 1 ? 'checked' : '' %>>
                          <label class="form-check-label fs-4" for="rating-<%= i %>">
                            <i class="bi <%= i === 1 ? 'bi-star-fill text-warning' : 'bi-star text-secondary' %>"></i>
                          </label>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="comment" class="form-label fw-medium">Your review</label>
                  <textarea
                    id="comment"
                    name="review[comment]"
                    rows="3"
                    class="form-control"
                    placeholder="What did you like about your stay? What could be improved?"
                    required
                  ></textarea>
                  <div class="invalid-feedback">Please share your thoughts about this stay</div>
                </div>

                <button class="btn btn-primary px-4">Submit Review</button>
              </form>
            </div>
          </div>
        <% } %>

        <% if(listing.reviews.length > 0) {%>
          <h5 class="fw-semibold mb-3">Guest reviews</h5>
          <div class="row g-3">
            <% for (let review of listing.reviews) { %>
              <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                  <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <div>
                        <h6 class="fw-semibold mb-0">@<%= review.author.username %></h6>
                        <div class="text-warning mb-2">
                          <% for (let i = 1; i <= 5; i++) { %>
                            <i class="bi <%= i <= review.rating ? 'bi-star-fill' : 'bi-star' %>"></i>
                          <% } %>
                        </div>
                      </div>
                      <% if (currUser && currUser._id.equals(review.author._id)) { %>
                        <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                          <button class="btn btn-sm btn-outline-danger py-0 px-2">Delete</button>
                        </form>
                      <% } %>
                    </div>
                    <p class="mb-0 text-muted"><%= review.comment %></p>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script src="/js/map.js"></script>