<% layout("/layouts/boilerplate")%>

<div class="row">
    <h1 class="col-6 offset-3">Login in Account</h1>
    <div class="col-6 offset-3">
        <form action="/login" method="post" class="needs-validation" novalidate >
            <div class="mb-3">
            <label for="username" class="form-label">Username:</label>
            <input name="username" type="text" placeholder="Enter your username" id="username" class="form-control" required>

            <div class="mb-3">
            <label for="password" class="form-label">Password:</label>
            <input name="password" placeholder="Enter your Password" id="password" type="password" class="form-control" required>
            </div> 
            <button class="btn btn-success">Login</button>


        </form>
    </div>
</div>

